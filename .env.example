# Database connection string (PostgreSQL for production, SQLite for local fallback if no PG server)
# Examples:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_rental
# DATABASE_URL=sqlite:///./property_rental.db
DATABASE_URL=sqlite:///./property_rental.db

# JWT Security
JWT_SECRET_KEY=super-secret-jwt-key-replace-in-production-takehome-07
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business Rules
GRACE_PERIOD_DAYS=5

# API Configuration
API_BASE_URL=http://localhost:8000
